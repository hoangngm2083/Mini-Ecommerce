    {
      "name": "3. Order Management",
      "description": "Complete order lifecycle with integrated payment and shipping. Order includes items, payment method, and shipping details.",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('order_id', response.id.toString());",
                  "    console.log('Order ID set to:', response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "userId",
                "value": "{{user_id}}",
                "description": "User ID passed in header"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": {{product_id}},\n      \"quantity\": 2\n    }\n  ],\n  \"payment\": {\n    \"method\": \"CREDIT_CARD\"\n  },\n  \"shipment\": {\n    \"address\": \"123 Main Street, Ho Chi Minh City\",\n    \"method\": \"STANDARD\",\n    \"notes\": \"Please handle with care\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            },
            "description": "Create a new order with selected products"
          },
          "response": []
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [
