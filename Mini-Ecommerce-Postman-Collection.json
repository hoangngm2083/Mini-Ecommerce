                "{{order_id}}"
              ]
            },
            "description": "Get detailed information of a specific order"
          },
          "response": []
        },
        {
          "name": "Update Order Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
