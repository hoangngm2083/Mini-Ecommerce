            "method": "GET",
            "header": [
              {
                "key": "userId",
                "value": "{{user_id}}",
                "description": "User ID passed in header"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
