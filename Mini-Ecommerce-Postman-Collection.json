              },
              {
                "key": "userId",
                "value": "{{user_id}}",
                "description": "User ID passed in header"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PENDING_PAYMENT\"\n}"
