            "url": {
              "raw": "{{base_url}}/api/orders/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "me"
              ]
            },
            "description": "Get list of user's orders"
          },
          "response": []
