    {
      "name": "5. Shipping Management",
      "description": "Shipping workflow: 1) Create shipment (status: CREATED), 2) Assign to employee (ASSIGN_TASK, status: SHIPPING), 3) Employee completes delivery (COMPLETE_TASK, status: COMPLETED)",
      "item": [
        {
          "name": "Create Shipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('shipment_id', response.id.toString());",
                  "    console.log('Shipment ID set to:', response.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": {{order_id}},\n  \"address\": \"123 Main Street, Ho Chi Minh City\",\n  \"method\": \"STANDARD\",\n  \"fee\": 50000,\n  \"notes\": \"Handle with care\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/shipments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shipments"
              ]
            },
            "description": "Create a shipment for the paid order"
          },
          "response": []
        },
        {
          "name": "Assign Shipment Task",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "userId",
                "value": "{{user_id}}",
                "description": "User ID of the employee assigning the task"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ASSIGN_TASK\",\n  \"shippedBy\": {{user_id}},\n  \"status\": \"SHIPPING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/shipments/{{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shipments",
                "{{shipment_id}}"
              ]
            },
            "description": "Assign shipment task to an employee (status must be CREATED)"
          },
          "response": []
        },
        {
          "name": "Complete Shipment Task",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "userId",
                "value": "{{user_id}}",
                "description": "User ID of the employee completing the task (must match assigned employee)"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"COMPLETE_TASK\",\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/shipments/{{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shipments",
                "{{shipment_id}}"
              ]
            },
            "description": "Complete shipment task (status must be SHIPPING, only assigned employee can complete)"
          },
          "response": []
        },
        {
          "name": "Assign Shipment Task",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "userId",
                "value": "{{user_id}}",
                "description": "User ID passed in header"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"ASSIGN_TASK\",\n  \"shippedBy\": {{user_id}},\n  \"status\": \"SHIPPING\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/shipments/{{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shipments",
                "{{shipment_id}}"
              ]
            },
            "description": "Assign shipment task to an employee (status must be CREATED)"
          },
          "response": []
        },
        {
          "name": "Test Complete Task - Wrong Employee (Should Fail)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "userId",
                "value": "999",
                "description": "Wrong user ID that doesn't match assigned employee"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"COMPLETE_TASK\",\n  \"status\": \"COMPLETED\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/shipments/{{shipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "shipments",
                "{{shipment_id}}"
              ]
            },
            "description": "Test validation: only assigned employee can complete task (should return 400 Bad Request)"
          },
          "response": []
        }
      ]
    },
